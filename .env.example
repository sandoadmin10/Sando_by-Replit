# All optional. With no key, SANDO runs in clearly-labelled Demo Mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai  (auto-detected from whichever key is set)
AI_PROVIDER=
# e.g. claude-sonnet-5-5 or gpt-4o-mini
AI_MODEL=
# PORT is provided by Replit automatically

# --- Sign-in instead of an API key (local use) ---
# Uses the Claude Code CLI's own login. Install the CLI, run `claude` once and sign in, then:
# AI_PROVIDER=claude-code
# Or, on a machine with no browser, create a token with `claude setup-token` and set:
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Cursor sign-in (local use) ---
# Install Cursor's CLI, run `cursor-agent login`, then:
# AI_PROVIDER=cursor
# Or set CURSOR_API_KEY= (from Cursor settings) on a host with no browser.
